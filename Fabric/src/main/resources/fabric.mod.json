{
    "schemaVersion": 1,
    "id": "bossrifts",
    "version": "${version}",
  
    "name": "Boss Rifts",
    "description": "Kill bosses while holding a Rift pearl to empower it, allowing you to teleport back home.",
    "authors": [
      "jodlodi"
    ],
    "contact": {
      "homepage": "https://www.curseforge.com/minecraft/mc-mods/boss-rifts",
      "sources": "https://github.com/jodlodi/BossRifts"
    },
  
    "license": "LGPL 2.1",
    "icon": "rift_logo.png",
  
    "environment": "*",
    "entrypoints": {
      "main": [
        "io.github.jodlodi.bossrifts.BossRifts"
      ],
      "client": [
        "io.github.jodlodi.bossrifts.client.ClientInit"
      ]
    },
    "mixins": [
      "bossrifts.mixins.json",
      "bossrifts.fabric.mixins.json"
    ],
  
    "depends": {
      "fabricloader": ">=0.13",
      "fabric": "*",
      "minecraft": "1.18.x",
      "java": ">=17"
    },
    "suggests": {
      "another-mod": "*"
    }
  }
  